# Postgres (pgvector) — matches docker-compose.yml for local dev
DATABASE_URL=postgres://rag:rag_dev_password@localhost:5432/compony_rag

# Gemini — used for both embeddings (gemini-embedding-001) and chat synthesis
# (gemini-3.5-flash-lite). Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# NextAuth
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Zoho — one Self Client covers CRM, Books, and Inventory (same Zoho One
# account). Create it at https://api-console.zoho.com -> Server-based
# Applications -> Self Client, and generate a grant code with READ-ONLY
# scopes across whichever of CRM/Books/Inventory modules you want queried —
# this app never writes to Zoho. Exchange the grant code once for a refresh
# token: POST {ZOHO_ACCOUNTS_BASE_URL}/oauth/v2/token with
# grant_type=authorization_code, client_id, client_secret, code.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Accounts/API domain varies by data center: .com (US), .eu, .in, .com.au, .jp
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com

# Required for Books and Inventory tools (both share the same organization).
# Find it in Zoho Books under Settings -> Organizations.
ZOHO_BOOKS_ORGANIZATION_ID=

# Optional: shared secret required in the header of POST /api/crm/sync so the
# refresh job can only be triggered by your own cron caller, not the public internet
CRM_SYNC_SECRET=replace-with-a-long-random-string

# Optional: Upstash Redis (free tier) for rate limiting shared across server
# instances. Without these, rate limiting falls back to in-memory (fine for a
# single instance, resets on restart). https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: Sentry error tracking (free tier). Without this, errors are only
# logged to the console. https://sentry.io
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional: scheduled email digest. Without RESEND_API_KEY + DIGEST_EMAIL_TO,
# POST /api/digest/email just declines to send rather than erroring — the
# in-app /digest page works regardless. Get a free key at https://resend.com
# (DIGEST_EMAIL_FROM defaults to onboarding@resend.dev, which needs no domain
# verification — fine to leave unset while testing). Wire an external
# scheduler (cron-job.org, EasyCron, a GitHub Actions cron workflow, ...) to
# POST this endpoint daily with header "x-digest-email-secret: <this value>".
RESEND_API_KEY=
DIGEST_EMAIL_TO=
DIGEST_EMAIL_FROM=
DIGEST_EMAIL_SECRET=replace-with-a-long-random-string
